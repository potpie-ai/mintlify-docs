{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Potpie",
  "colors": {
    "primary": "#B6E343",
    "light": "#B6E343",
    "dark": "#B6E343"
  },
  "favicon": "/favicon.png",
  "customCSS": [
    "/styles/custom.css"
  ],
  "openapi": "/api-reference/openapi.json",
  "api": {
    "baseUrl": "http://localhost:8001",
    "auth": {
      "method": "key",
      "name": "x-api-key"
    },
    "playground": {
      "mode": "show"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/parsing",
              "concepts/inference",
              "concepts/knowledge-graph"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/explore-your-codebase",
              "tutorials/make-code-changes",
              "tutorials/trace-and-fix",
              "tutorials/configure-custom-agents",
              "tutorials/generate-api-key"
            ]
          },
          {
            "group": "Modes",
            "pages": [
              "build-flow/overview",
              "build-flow/ask-a-question",
              "build-flow/build-a-feature",
              "build-flow/debug-an-issue"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "build-flow/forge",
              "build-flow/specialists",
              "build-flow/recipe",
              "build-flow/trace"
            ]
          },
          {
            "group": "Developer",
            "pages": [
              "agents/api-access",
              {
                "group": "Pre-built Agents",
                "pages": [
                  "agents/qna-agent",
                  "agents/code-changes-agent",
                  "agents/debugging-agent",
                  "pre-built-agents/specgen-agent"
                ]
              },
              "custom-agents/introduction",
              {
                "group": "Integrations",
                "pages": [
                  "extensions/overview",
                  "extensions/github",
                  "extensions/linear",
                  "extensions/jira",
                  "extensions/confluence",
                  "extensions/sentry",
                  "extensions/slack",
                  "extensions/vscode"
                ]
              },
              "self-hosting/setup",
              "agents/tools-reference"
            ]
          },
          {
            "group": "Example Uses",
            "pages": [
              "examples/impact-analysis",
              "examples/code-migration",
              "examples/race-conditions",
              "examples/auth-flow",
              "examples/refactor-scope",
              "examples/api-endpoint",
              "examples/auth-middleware",
              "examples/null-pointer",
              "examples/memory-leak"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Potpie API",
            "pages": [
              "api-reference/overview",
              "api-reference/endpoint/parse-directory",
              "api-reference/endpoint/get-parsing-status",
              "api-reference/endpoint/create-conversation",
              "api-reference/endpoint/post-message",
              "api-reference/endpoint/create-conversation-and-message",
              "api-reference/endpoint/list-projects",
              "api-reference/endpoint/list-agents",
              "api-reference/endpoint/save-integration"
            ]
          }
        ]
      }
    ],
    "global": {}
  },
  "feedback": {
    "thumbsRating": true
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://potpie.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/potpie-ai/potpie"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/ryk5CMD5v6"
      },
      {
        "label": "Support",
        "href": "mailto:hi@potpie.ai"
      }
    ]
  },
  "contextual": {
    "options": [
      {
        "title": "Ask ChatGPT",
        "description": "Ask ChatGPT about this page",
        "icon": "message",
        "href": {
          "base": "https://chatgpt.com/",
          "query": [
            {
              "key": "q",
              "value": "Here is some documentation. Answer any questions I have about it: $page"
            }
          ]
        }
      },
      {
        "title": "Ask Claude",
        "description": "Ask Claude about this page",
        "icon": "message",
        "href": {
          "base": "https://claude.ai/new",
          "query": [
            {
              "key": "q",
              "value": "Here is some documentation. Answer any questions I have about it: $page"
            }
          ]
        }
      },
      "perplexity",
      "copy"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/potpiedotai",
      "github": "https://github.com/potpie-ai/potpie",
      "linkedin": "https://www.linkedin.com/company/potpieai",
      "discord": "https://discord.gg/ryk5CMD5v6"
    }
  }
}