{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Potpie",
  "colors": {
    "primary": "#B6E343",
    "light": "#B6E343",
    "dark": "#B6E343"
  },
  "favicon": "/favicon.png",
  "customCSS": [
    "/styles/custom.css"
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/context-engine",
              "concepts/parsing"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/explore-your-codebase",
              "tutorials/make-code-changes",
              "tutorials/trace-and-fix",
              "tutorials/configure-custom-agents",
              "tutorials/generate-api-key"
            ]
          },
          {
            "group": "Modes",
            "pages": [
              "build-flow/overview",
              "build-flow/ask-a-question",
              "build-flow/build-a-feature",
              "build-flow/debug-an-issue"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "build-flow/forge",
              "build-flow/specialists",
              "build-flow/recipe",
              "build-flow/trace"
            ]
          },
          {
            "group": "Developer",
            "pages": [
              "agents/api-access",
              {
                "group": "Pre-built Agents",
                "pages": [
                  "agents/qna-agent",
                  "agents/code-changes-agent",
                  "agents/debugging-agent",
                  "pre-built-agents/specgen-agent"
                ]
              },
              "custom-agents/introduction",
              "self-hosting/setup",
              "agents/tools-reference"
            ]
          },
          {
            "group": "Example Uses",
            "pages": [
              "examples/overview",
              "examples/impact-analysis",
              "examples/code-migration",
              "examples/auth-flow",
              "examples/refactor-scope",
              "examples/rate-limiting",
              "examples/auth-middleware",
              "examples/null-pointer",
              "examples/memory-leak",
              "examples/race-conditions",
              "examples/code-review"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "cli/introduction",
              "cli/installation",
              "cli/how-to-use"
            ]
          },
          {
            "group": "CLI Reference",
            "pages": [
              "cli/reference",
              "cli/setup-and-lifecycle",
              "cli/context-commands",
              "cli/pots-and-sources",
              "cli/integrations-and-auth",
              "cli/graph-and-operations",
              "cli/manual"
            ]
          }
        ]
      }
    ],
    "global": {}
  },
  "feedback": {
    "thumbsRating": true
  },
  "redirects": [
    { "source": "/context-engine/introduction", "destination": "/cli/introduction" },
    { "source": "/context-engine/installation", "destination": "/cli/installation" },
    { "source": "/context-engine/how-to-use", "destination": "/cli/how-to-use" },
    { "source": "/api-reference/cli/overview", "destination": "/cli/reference" },
    { "source": "/api-reference/cli/:slug*", "destination": "/cli/:slug*" }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://potpie.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/potpie-ai/potpie"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/ryk5CMD5v6"
      },
      {
        "label": "Support",
        "href": "mailto:hi@potpie.ai"
      }
    ]
  },
  "contextual": {
    "options": [
      {
        "title": "Ask ChatGPT",
        "description": "Ask ChatGPT about this page",
        "icon": "message",
        "href": {
          "base": "https://chatgpt.com/",
          "query": [
            {
              "key": "q",
              "value": "Here is some documentation. Answer any questions I have about it: $page"
            }
          ]
        }
      },
      {
        "title": "Ask Claude",
        "description": "Ask Claude about this page",
        "icon": "message",
        "href": {
          "base": "https://claude.ai/new",
          "query": [
            {
              "key": "q",
              "value": "Here is some documentation. Answer any questions I have about it: $page"
            }
          ]
        }
      },
      "perplexity",
      "copy"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/potpiedotai",
      "github": "https://github.com/potpie-ai/potpie",
      "linkedin": "https://www.linkedin.com/company/potpieai",
      "discord": "https://discord.gg/ryk5CMD5v6"
    }
  }
}
